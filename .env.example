# ── Base de datos ───────────────────────────────────────────────
DATABASE_URL=postgres://mindmatch:mindmatch@localhost:55432/mindmatch

# ── Redis (BullMQ) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
PATIENT_APP_URL=http://localhost:5173
# demo | development | production
NODE_ENV=demo

# JWT (cambiar en producción)
JWT_SECRET=dev-super-secret-change-me
JWT_REFRESH_SECRET=dev-super-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Multi-tenancy: clínica por defecto del demo. El login es tenant-aware
# (clinicSlug + email + password), así que este slug debe coincidir con el del seed.
DEFAULT_CLINIC_SLUG=mindmatch-demo

# Matching: DEMO_MODE lee scores sembrados; false usa embeddings + pgvector
DEMO_MODE=true
# Proveedor de matching (Fase 3): demo lee social.match_scores; pgvector usa embeddings.
MATCHING_PROVIDER=demo

# Claude API (solo se usa fuera de DEMO_MODE; opcional en el demo)
ANTHROPIC_API_KEY=

# Bootstrap local de doctora demo (no usar en producción)
DEMO_DOCTOR_EMAIL=doctora@demo.com
DEMO_DOCTOR_PASSWORD=Demo123!

# Seed demo (Fase 2): guardas destructivas. `pnpm seed` SOLO corre con
# ALLOW_DEMO_SEED=true, contra localhost/127.0.0.1 y el puerto permitido.
# El reset se limita exclusivamente al tenant con slug `mindmatch-demo`.
ALLOW_DEMO_SEED=true
SEED_ALLOWED_DB_PORT=55432

# ── Frontends ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
# Slug de clínica prellenado en el login de ambos frontends (demo).
VITE_DEFAULT_CLINIC_SLUG=mindmatch-demo
