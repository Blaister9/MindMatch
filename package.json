{
  "name": "mindmatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter @mindmatch/api seed",
    "db:generate": "pnpm --filter @mindmatch/api db:generate",
    "db:migrate": "pnpm --filter @mindmatch/api db:migrate",
    "db:push": "pnpm --filter @mindmatch/api db:push",
    "db:studio": "pnpm --filter @mindmatch/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
